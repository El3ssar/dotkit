# Sourced by kit-shell (and setup.sh): points everything at ~/.local/kit.
# Own XDG dirs keep the remote's existing ~/.config, ~/.zshrc, nvim, ... untouched.
KIT="${KIT:-$HOME/.local/kit}"
export KIT KIT_ACTIVE=1

# shellcheck shell=bash
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
# Preserve ordinary ~/.zshrc setups as well as fizsh's ~/.fizsh/.zshrc.
if [ -f "$HOME/.fizsh/.zshrc" ]; then export ZDOTDIR="$HOME/.fizsh"
else export ZDOTDIR="$HOME"; fi
if [ "$(uname -s)" = Darwin ]; then
  # Fill missing standard locations without overriding the caller's selected
  # provider (or the PATH stubs used by isolated provisioning tests).
  case ":$PATH:" in *:/opt/homebrew/bin:*) ;; *) PATH="$PATH:/opt/homebrew/bin" ;; esac
  case ":$PATH:" in *:/usr/local/bin:*) ;; *) PATH="$PATH:/usr/local/bin" ;; esac
  export PATH
fi
export ZELLIJ_CONFIG_DIR="$XDG_CONFIG_HOME/zellij"
export EDITOR=nvim
export SHELL="$KIT/bin/fizsh"

# tools from packages.json, installed by mise inside the kit
export MISE_DATA_DIR="$KIT/mise" MISE_CACHE_DIR="$KIT/cache/mise" MISE_STATE_DIR="$KIT/state/mise"
export MISE_GLOBAL_CONFIG_FILE="$KIT/mise.toml" MISE_CONFIG_DIR="$KIT/config/mise"
export MISE_TRUSTED_CONFIG_PATHS="$KIT" MISE_YES=1
# Preserve an existing Rust installation and explicit user overrides. Only use
# Kit's private toolchain when no ordinary toolchain is present. Provisioning
# sets its private build roots separately from the user's shell environment.
if [ -z "${RUSTUP_HOME:-}" ] && [ ! -d "$HOME/.rustup/toolchains" ] && [ -d "$KIT/rustup/toolchains" ]; then
  export RUSTUP_HOME="$KIT/rustup"
fi
if [ -z "${CARGO_HOME:-}" ] && [ ! -d "$HOME/.cargo" ] && [ -d "$KIT/cargo" ]; then
  export CARGO_HOME="$KIT/cargo"
fi
export MISE_CARGO_BINSTALL=false

# Check every entry independently: a pre-existing Kit bin directory does not
# imply that tool shims (or an existing Cargo installation) are already on PATH.
for kit_path in "$HOME/.cargo/bin" "$HOME/.elan/bin" "$HOME/.local/bin" "$KIT/opt/nvim/bin" "$KIT/mise/shims" "$KIT/opt/zsh/bin" "$KIT/cargo/bin" "$KIT/bin"; do
  case ":$PATH:" in *":$kit_path:"*) ;; *) PATH="$kit_path:$PATH" ;; esac
done
unset kit_path
export PATH

# kitty's terminfo and shell integration travel with the kit
# (trailing ':' keeps the system terminfo database too)
export TERMINFO_DIRS="$KIT/share/terminfo:${TERMINFO_DIRS:-}"
if [ "${TERM:-}" = xterm-kitty ] && [ -d "$KIT/share/kitty/shell-integration" ]; then
  export KITTY_INSTALLATION_DIR="$KIT/share/kitty"
fi
