#!/usr/bin/env bash
# Starts upstream fizsh when installed, otherwise zsh with your tracked configuration.
# Installed as ~/.local/kit/bin/kit-shell and ~/.local/kit/bin/fizsh.
#   kit-shell --ok   exits 0 only if the kit's zsh actually runs (used by the login hook,
#                    so a broken kit never locks you out: you just get your normal shell)
KIT="${KIT:-$HOME/.local/kit}"
ZSH_BIN="$KIT/opt/zsh/bin/zsh"

if [ "${1:-}" = "--ok" ]; then
  [ -x "$ZSH_BIN" ] || ZSH_BIN=$(command -v zsh) || exit 1
  "$ZSH_BIN" -fc true >/dev/null 2>&1
  exit $?
fi

. "$KIT/bin/kit-env"
if [ ! -x "$ZSH_BIN" ]; then ZSH_BIN=$(command -v zsh) || exit 1; fi
if [ -x "$KIT/opt/fizsh/bin/fizsh" ]; then
  # Fizsh initializes completion itself. Ubuntu's global compinit runs earlier and
  # can block startup with a prompt before fizsh has loaded its configuration.
  export skip_global_compinit=1
  # Upstream resolves its support files through the location of `which fizsh`.
  PATH="$KIT/opt/fizsh/bin:$(dirname "$ZSH_BIN"):$PATH"
  export PATH
  exec "$ZSH_BIN" "$KIT/opt/fizsh/bin/fizsh" "$@"
fi
exec -a fizsh "$ZSH_BIN" "$@"
